# Source-only publishing. Root items are private unless explicitly allowed.
/*
!/.gitignore
!/.env.example
!/README.md
!/requirements.txt
!/start_yuki.py
!/start_yuki.cmd
!/rebuild_frontend.cmd

!/app/
/app/*
!/app/package.json
!/app/package-lock.json
!/app/tsconfig.json
!/app/vite.config.ts
!/app/index.html
!/app/src/
!/app/vendor/
/app/vendor/*
!/app/vendor/live2d/
/app/vendor/live2d/*
!/app/vendor/live2d/Framework/
!/app/vendor/live2d/Core/
/app/vendor/live2d/Core/*
!/app/vendor/live2d/Core/live2dcubismcore.d.ts
!/app/vendor/live2d/Core/LICENSE.md
!/app/vendor/live2d/Core/RedistributableFiles.txt

!/scripts/
/scripts/*
!/scripts/settings.py
!/scripts/yuki_chat.py
!/scripts/yuki_history.py
!/scripts/yuki_server.py
!/scripts/yuki_window.py
!/scripts/yuki_config.py
!/scripts/yuki_speech.py
!/scripts/yuki_story.py
!/scripts/yuki_capture.py
!/scripts/install_textractor.py
!/scripts/test_capture.py
!/scripts/verify_capture_native.py
!/scripts/verify_capture.cjs
!/scripts/test_story_memory.py
!/scripts/verify_story.cjs
!/scripts/test_window_settings.py
!/scripts/test_window_backend.py
!/scripts/verify_window.cjs
!/scripts/audit_upload.py

!/docs/
/docs/*
!/docs/PUBLISHING.md
!/third_party/
/third_party/*
!/third_party/README.md
!/third_party/Open-LLM-VTuber-MIT.txt

# Credentials, local state, compiled output and model/media assets stay local.
.env
.yuki.local.json*
.env.*
!/.env.example
**/node_modules/
**/dist/
**/__pycache__/
*.pyc
*.pem
*.key
*.p12
*.pfx
*.moc3
*.model3.json
*.exp3.json
*.motion3.json
